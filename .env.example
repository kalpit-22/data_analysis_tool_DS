# ──── Environment template (copy to .env and fill in) ────
# NEVER commit the real .env file to version control.

# --- Cloud Coder Agent (DeepSeek V4 Pro) ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Local Planner / Reviewer Agents (vLLM serving Qwen3-8B-AWQ) ---
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-8B-AWQ
LOCAL_LLM_API_KEY=not-needed

# --- Executor Sandbox ---
WORKSPACE_DIR=./workspace
EXEC_TIMEOUT_SECONDS=15

# --- Self-correction loop ---
MAX_RETRIES_PER_TASK=3
